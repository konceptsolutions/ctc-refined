# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koncepts_dev"

# Replace with your actual PostgreSQL credentials:
# postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE_NAME

# Examples:
# Local PostgreSQL: postgresql://postgres:admin@localhost:5432/ctc_refined
# Remote PostgreSQL: postgresql://user:password@host:5432/dbname

# JWT Secret (generate a secure random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV=development

# Account IDs for sales vouchers (Inventory, Cost Inventory, Goods Sold, Goods Sold Discount, GST)
# Set these when using a live DB backup to avoid wrong account picks.
# To find IDs: SELECT id, code, name FROM "Account" WHERE code IN ('101001','901001','701001','502001','701002','401001');
# ACCOUNT_ID_INVENTORY=
# ACCOUNT_ID_COST_INVENTORY=
# ACCOUNT_ID_GOODS_SOLD=
# ACCOUNT_ID_GOODS_SOLD_DISCOUNT=
# ACCOUNT_ID_GST=
