# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koncepts_dev"

# Replace with your actual PostgreSQL credentials:
# postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE_NAME

# Examples:
# Local PostgreSQL: postgresql://postgres:admin@localhost:5432/ctc_refined
# Remote PostgreSQL: postgresql://user:password@host:5432/dbname

# JWT Secret (generate a secure random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV=development
