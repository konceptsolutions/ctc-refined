generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String         @id @default(uuid())
  subgroupId          String
  code                String         @unique
  name                String
  description         String?
  accountType         String         @default("regular")
  openingBalance      Float          @default(0)
  currentBalance      Float          @default(0)
  status              String         @default("Active")
  canDelete           Boolean        @default(true)
  supplierId          String?
  customerId          String?
  employeeId          String?
  employeeAccountRole String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  Customer            Customer?      @relation(fields: [customerId], references: [id])
  Employee            Employee?      @relation(fields: [employeeId], references: [id])
  Subgroup            Subgroup       @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  Supplier            Supplier?      @relation(fields: [supplierId], references: [id])
  SalesInvoice              SalesInvoice[]
  SalesInvoiceBankPayments  SalesInvoice[]         @relation("SalesInvoiceBankAccount")
  SalesInvoiceCashPayments  SalesInvoice[]         @relation("SalesInvoiceCashAccount")
  SalesReturnPayments       SalesReturn[]          @relation("SalesReturnPaymentAccount")
  VoucherEntry              VoucherEntry[]
  DirectPurchaseOrderBranch DirectPurchaseOrder[]  @relation("DirectPurchaseOrderBranchAccount")
}

model ActivityLog {
  id          String   @id @default(uuid())
  timestamp   String
  user        String
  userId      String?
  userRole    String
  action      String
  actionType  String
  module      String
  description String
  entityType  String?
  entityId    String?
  entityLabel String?
  ipAddress   String
  status      String   @default("success")
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actionType])
  @@index([module])
}

model Adjustment {
  id                                       String           @id @default(uuid())
  adjustmentNo                             Int              @unique @default(autoincrement())
  date                                     DateTime
  subject                                  String?
  storeId                                  String?
  addInventory                             Boolean          @default(true)
  notes                                    String?
  totalAmount                              Float            @default(0)
  status                                   String           @default("pending")
  voucherId                                String?
  deletedAt                                DateTime?
  createdAt                                DateTime         @default(now())
  updatedAt                                DateTime         @updatedAt
  Store                                    Store?           @relation(fields: [storeId], references: [id])
  Voucher_Adjustment_voucherIdToVoucher    Voucher?         @relation("Adjustment_voucherIdToVoucher", fields: [voucherId], references: [id])
  AdjustmentItem                           AdjustmentItem[]
  Voucher_Voucher_adjustmentIdToAdjustment Voucher[]        @relation("Voucher_adjustmentIdToAdjustment")
  VoucherEntry                             VoucherEntry[]
}

model AdjustmentItem {
  id           String     @id @default(uuid())
  adjustmentId String
  partId       String
  quantity     Int
  cost         Float?
  notes        String?
  rackId       String?
  shelfId      String?
  createdAt    DateTime   @default(now())
  priceA       Float?
  priceB       Float?
  priceM       Float?
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  Adjustment   Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  Part         Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack         Rack?      @relation(fields: [rackId], references: [id])
  Shelf        Shelf?     @relation(fields: [shelfId], references: [id])
}

model Area {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id            String       @id @default(uuid())
  subcategoryId String?
  masterPartId  String?
  name          String
  status        String       @default("active")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  MasterPart    MasterPart?  @relation(fields: [masterPartId], references: [id], onDelete: Cascade)
  Subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  Part          Part[]

  @@unique([masterPartId, name])
  @@index([masterPartId])
  @@index([subcategoryId])
}

model ApprovalFlow {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("active")
  description String?
  steps       String
  module      String
  trigger     String   @default("On Create")
  condition   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Backup {
  id        String  @id @default(uuid())
  name      String
  tables    String
  type      String  @default("full")
  size      String?
  status    String  @default("in_progress")
  createdAt String
  createdBy String
}

model BackupSchedule {
  id        String   @id @default(uuid())
  name      String
  frequency String
  tables    String
  time      String
  status    String   @default("active")
  lastRun   String?
  nextRun   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  longName  String?  @map("long_name")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Part      Part[]
}

model Category {
  id          String        @id @default(uuid())
  name        String        @unique
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Part        Part[]
  Subcategory Subcategory[]
}

model CompanyProfile {
  id                   String   @id @default(uuid())
  companyInfo          String
  systemSettings       String
  invoiceSettings      String
  notificationSettings String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Customer {
  id                 String         @id @default(uuid())
  name               String
  address            String?
  email              String?
  cnic               String?
  contactNo          String?
  openingBalance     Float          @default(0)
  date               DateTime?
  creditLimit        Float          @default(0)
  status             String         @default("active")
  priceType          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  accountHead        String?
  area               String?
  cellNumber         String?
  code               String?        @unique
  contactPersons     Json?          @default("[]")
  gstNumber          String?
  ntn                String?
  pstNumber          String?
  referenceName      String?
  remarks            String?
  shortTitle         String?
  accountClosingDate DateTime?
  accountOpeningDate DateTime?
  category           String?
  tax                Float?         @default(0)
  Account            Account[]
  Receivable         Receivable[]
  SalesInvoice       SalesInvoice[]
  SalesQuotation     SalesQuotation[]
  SalesReturn        SalesReturn[]
  VoucherEntry       VoucherEntry[]
}

model Employee {
  id                    String                @id @default(uuid())
  code                  String                @unique
  name                  String
  cnic                  String?
  contactNo             String?
  email                 String?
  address               String?
  designation           String?
  department            String?
  joiningDate           DateTime?
  openingBalanceDate    DateTime?
  monthlySalary         Float                 @default(0)
  workingDays           Int                   @default(26)
  status                String                @default("active")
  remarks               String?
  openingLoanBalance    Float                 @default(0)
  openingAdvanceBalance Float                 @default(0)
  openingSalaryPayable  Float                 @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  Account               Account[]
  EmployeeTransaction   EmployeeTransaction[]
  VoucherEntry          VoucherEntry[]
}

model EmployeeTransaction {
  id              String   @id @default(uuid())
  employeeId      String
  type            String
  date            DateTime
  payrollMonth    String?
  amount          Float
  absentDays      Float    @default(0)
  workingDays     Float?
  loanRecovery    Float    @default(0)
  advanceRecovery Float    @default(0)
  netPaid         Float    @default(0)
  description     String?
  voucherId       String?
  referenceNo     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Voucher         Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([date])
  @@index([type])
  @@index([employeeId, payrollMonth])
}

model DeliveryLog {
  id              String            @id @default(uuid())
  invoiceId       String
  challanNo       String
  deliveryDate    DateTime
  deliveredBy     String?
  createdAt       DateTime          @default(now())
  SalesInvoice    SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  DeliveryLogItem DeliveryLogItem[]
}

model DeliveryLogItem {
  id               String           @id @default(uuid())
  deliveryLogId    String
  invoiceItemId    String
  quantity         Int
  createdAt        DateTime         @default(now())
  DeliveryLog      DeliveryLog      @relation(fields: [deliveryLogId], references: [id], onDelete: Cascade)
  SalesInvoiceItem SalesInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
}

model DirectPurchaseOrder {
  id                         String                       @id @default(uuid())
  dpoNumber                  String                       @unique
  date                       DateTime
  invoiceNo                  String?
  invoiceDate                DateTime?
  storeId                    String?
  supplierId                 String?
  branchAccountId            String?
  orderType                  String                       @default("local_purchase")
  account                    String?
  description                String?
  status                     String                       @default("Completed")
  /// Supplier / trade discount applied to line items subtotal only (not expenses)
  discount                   Float                        @default(0)
  totalAmount                Float                        @default(0)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  Store                      Store?                       @relation(fields: [storeId], references: [id])
  Supplier                   Supplier?                    @relation(fields: [supplierId], references: [id])
  BranchAccount              Account?                     @relation("DirectPurchaseOrderBranchAccount", fields: [branchAccountId], references: [id])
  DirectPurchaseOrderExpense DirectPurchaseOrderExpense[]
  DirectPurchaseOrderItem    DirectPurchaseOrderItem[]
  DirectPurchaseOrderReturn  DirectPurchaseOrderReturn[]
}

model DirectPurchaseOrderExpense {
  id                    String              @id @default(uuid())
  directPurchaseOrderId String
  expenseType           String
  payableAccount        String
  description           String?
  amount                Float
  createdAt             DateTime            @default(now())
  DirectPurchaseOrder   DirectPurchaseOrder @relation(fields: [directPurchaseOrderId], references: [id], onDelete: Cascade)
}

model DirectPurchaseOrderItem {
  id                    String              @id @default(uuid())
  directPurchaseOrderId String
  partId                String
  quantity              Int
  purchasePrice         Float
  salePrice             Float
  amount                Float
  priceA                Float?
  priceB                Float?
  priceM                Float?
  rackId                String?
  shelfId               String?
  createdAt             DateTime            @default(now())
  DirectPurchaseOrder   DirectPurchaseOrder @relation(fields: [directPurchaseOrderId], references: [id], onDelete: Cascade)
  Part                  Part                @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack                  Rack?               @relation(fields: [rackId], references: [id])
  Shelf                 Shelf?              @relation(fields: [shelfId], references: [id])
}

model DirectPurchaseOrderReturn {
  id                            String                          @id @default(uuid())
  returnNumber                  String                          @unique
  directPurchaseOrderId         String
  returnDate                    DateTime
  reason                        String?
  status                        String                          @default("pending")
  totalAmount                   Float                           @default(0)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  supplierId                    String?
  deduction                     Float                           @default(0)
  netAmount                     Float                           @default(0)
  DirectPurchaseOrder           DirectPurchaseOrder             @relation(fields: [directPurchaseOrderId], references: [id], onDelete: Cascade)
  Supplier                      Supplier?                       @relation(fields: [supplierId], references: [id])
  DirectPurchaseOrderReturnItem DirectPurchaseOrderReturnItem[]

  @@index([directPurchaseOrderId])
  @@index([status])
}

model DirectPurchaseOrderReturnItem {
  id                        String                    @id @default(uuid())
  dpoReturnId               String
  partId                    String
  returnQuantity            Int
  originalPurchasePrice     Float
  amount                    Float
  createdAt                 DateTime                  @default(now())
  DirectPurchaseOrderReturn DirectPurchaseOrderReturn @relation(fields: [dpoReturnId], references: [id], onDelete: Cascade)
  Part                      Part                      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([dpoReturnId])
  @@index([partId])
}

model ExpenseType {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  description   String?
  category      String
  budget        Float           @default(0)
  spent         Float           @default(0)
  status        String          @default("Active")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PostedExpense PostedExpense[]
}

model LongCatSettings {
  id        String   @id @default(uuid())
  apiKey    String?
  model     String?  @default("LongCat-Flash-Chat")
  baseUrl   String?  @default("https://api.longcat.chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MainGroup {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  type         String
  displayOrder Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Subgroup     Subgroup[]
}

model MasterPart {
  id           String        @id @default(uuid())
  masterPartNo String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Application  Application[]
  Part         Part[]
}

model Model {
  id        String   @id @default(uuid())
  partId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  qtyUsed   Int      @default(1)
  Part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, name])
}

model OperationalExpense {
  id          String   @id @default(uuid())
  date        DateTime
  voucherNo   String   @unique
  expenseType String
  description String?
  paidTo      String
  amount      Float
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Part {
  id                            String                          @id @default(uuid())
  masterPartId                  String?
  partNo                        String
  brandId                       String?
  description                   String?
  categoryId                    String?
  subcategoryId                 String?
  applicationId                 String?
  hsCode                        String?
  weight                        Float?
  reorderLevel                  Int                             @default(0)
  uom                           String                          @default("pcs")
  cost                          Float?
  purchasePrice                 Float?
  avgCost                       Float?
  costSource                    String?
  costSourceRef                 String?
  costUpdatedAt                 DateTime?
  priceA                        Float?
  priceB                        Float?
  priceM                        Float?
  smc                           String?
  size                          String?
  origin                        String?
  type                          String                          @default("single")
  imageP1                       String?
  imageP2                       String?
  status                        String                          @default("active")
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  AdjustmentItem                AdjustmentItem[]
  DirectPurchaseOrderItem       DirectPurchaseOrderItem[]
  DirectPurchaseOrderReturnItem DirectPurchaseOrderReturnItem[]
  KitItem                       KitItem[]                       @relation("KitItemParentPart")
  ReferencedAsKitComponent      KitItem[]                       @relation("KitItemComponentPart")
  Model                         Model[]
  Application                   Application?                    @relation(fields: [applicationId], references: [id])
  Brand                         Brand?                          @relation(fields: [brandId], references: [id])
  Category                      Category?                       @relation(fields: [categoryId], references: [id])
  MasterPart                    MasterPart?                     @relation(fields: [masterPartId], references: [id])
  Subcategory                   Subcategory?                    @relation(fields: [subcategoryId], references: [id])
  PartRackShelf                 PartRackShelf[]
  PriceHistory                  PriceHistory[]
  PurchaseOrderItem             PurchaseOrderItem[]
  PurchaseImportRequestItem     PurchaseImportRequestItem[]
  PurchaseQuotationItem         PurchaseQuotationItem[]
  SalesInquiryItem              SalesInquiryItem[]
  SalesInvoiceItem              SalesInvoiceItem[]
  SalesQuotationItem            SalesQuotationItem[]
  SalesReturnItem               SalesReturnItem[]
  StockMovement                 StockMovement[]
  StockReservation              StockReservation[]
  StockVerificationItem         StockVerificationItem[]
  TransferItem                  TransferItem[]
  LocalInquiryItem              LocalInquiryItem[]
}

model KitItem {
  id                String   @id @default(uuid())
  partId            String
  /// Exact component Part row (same partNo can exist for multiple brands).
  componentPartId   String?
  partNo            String
  partName          String
  quantity          Int      @default(1)
  costPerUnit       Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ParentKitPart     Part     @relation("KitItemParentPart", fields: [partId], references: [id], onDelete: Cascade)
  ComponentPart     Part?    @relation("KitItemComponentPart", fields: [componentPartId], references: [id], onDelete: Restrict)

  @@index([partId])
  @@index([componentPartId])
  @@index([createdAt])
}

model PurchaseImportRequest {
  id                        String                      @id @default(uuid())
  requestNo                 String                      @unique
  batchId                   String
  supplierId                String?
  partReference             String?
  consignee                 String?
  status                    String                      @default("pending")
  notes                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  Supplier                  Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  PurchaseImportRequestItem PurchaseImportRequestItem[]
  PurchaseQuotation         PurchaseQuotation[]

  @@index([batchId])
  @@index([requestNo])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseImportRequestItem {
  id                      String                @id @default(uuid())
  purchaseImportRequestId String
  partId                  String
  currentStock            Int                   @default(0)
  demandQuantity          Int
  khiQuantity             Int                   @default(0)
  isbQuantity             Int                   @default(0)
  otherQuantity           Int                   @default(0)
  weight                  Float                 @default(0)
  totalWeight             Float                 @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  Part                    Part                  @relation(fields: [partId], references: [id], onDelete: Cascade)
  PurchaseImportRequest   PurchaseImportRequest @relation(fields: [purchaseImportRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseImportRequestId])
  @@index([partId])
  @@index([createdAt])
}

model PurchaseQuotation {
  id                      String                 @id @default(uuid())
  quotationNo             String                 @unique
  purchaseImportRequestId String
  supplierId              String
  currency                String
  conversionRate          Float                  @default(1)
  fcTotal                 Float                  @default(0)
  lcTotal                 Float                  @default(0)
  fcRevisedTotal          Float                  @default(0)
  lcRevisedTotal          Float                  @default(0)
  quotationDate           DateTime
  revisedQuotationDate    DateTime?
  quotationType           String                 @default("original")
  terms                   String?
  status                  String                 @default("pending")
  confirmationDate        DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  PurchaseImportRequest   PurchaseImportRequest  @relation(fields: [purchaseImportRequestId], references: [id], onDelete: Cascade)
  Supplier                Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  PurchaseQuotationItem     PurchaseQuotationItem[]
  PurchaseOrder             PurchaseOrder[]

  @@index([purchaseImportRequestId])
  @@index([supplierId])
  @@index([quotationDate])
  @@index([createdAt])
}

model PurchaseQuotationItem {
  id                  String            @id @default(uuid())
  purchaseQuotationId String
  partId              String
  demandQuantity      Int
  quotationQuantity   Int
  shipDays            Int               @default(0)
  fcRate              Float             @default(0)
  fcAmount            Float             @default(0)
  lcRate              Float             @default(0)
  lcAmount            Float             @default(0)
  revisedFcRate       Float             @default(0)
  revisedFcAmount     Float             @default(0)
  revisedLcRate       Float             @default(0)
  revisedLcAmount     Float             @default(0)
  weight              Float             @default(0)
  totalWeight         Float             @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  PurchaseQuotation   PurchaseQuotation @relation(fields: [purchaseQuotationId], references: [id], onDelete: Cascade)
  Part                Part              @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([purchaseQuotationId])
  @@index([partId])
  @@index([createdAt])
}

model PostedExpense {
  id              String      @id @default(uuid())
  date            DateTime
  expenseTypeId   String
  amount          Float
  paidTo          String
  paymentMode     String      @default("Cash")
  referenceNumber String?
  description     String?
  createdAt       DateTime    @default(now())
  ExpenseType     ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id           String   @id @default(uuid())
  partId       String?
  partNo       String
  description  String?
  priceField   String
  updateType   String
  oldValue     Float?
  newValue     Float?
  updateValue  Float?
  itemsUpdated Int      @default(1)
  reason       String
  updatedBy    String?
  createdAt    DateTime @default(now())
  Part         Part?    @relation(fields: [partId], references: [id])
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  poNumber            String              @unique
  date                DateTime
  supplierId          String?
  purchaseQuotationId String?
  consignee           String?
  currency            String?
  conversionRate      Float               @default(1)
  fcTotal             Float               @default(0)
  invoiceNo           String?
  invoiceDate         DateTime?
  blNo                String?
  blDate              DateTime?
  forwarder           String?
  pkgExpPercent       Float               @default(0)
  invDiscPercent      Float               @default(0)
  frtExp              Float               @default(0)
  discAmt             Float               @default(0)
  customsDuty         Float               @default(0)
  additionalCustomsDuty Float             @default(0)
  regulatoryDuty      Float               @default(0)
  salesTax            Float               @default(0)
  additionalSalesTax  Float               @default(0)
  incomeTax           Float               @default(0)
  ed                  Float               @default(0)
  doAmount            Float               @default(0)
  crnExp              Float               @default(0)
  cmExp               Float               @default(0)
  agencyExp           Float               @default(0)
  miscExp             Float               @default(0)
  locFrt              Float               @default(0)
  totalExp            Float               @default(0)
  status              String              @default("Draft")
  expectedDate        DateTime?
  notes               String?
  totalAmount         Float               @default(0)
  transferOutInvoiceId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  Supplier            Supplier?           @relation(fields: [supplierId], references: [id])
  PurchaseQuotation   PurchaseQuotation?  @relation(fields: [purchaseQuotationId], references: [id], onDelete: SetNull)
  PurchaseOrderItem   PurchaseOrderItem[]

  @@index([purchaseQuotationId])
  @@index([transferOutInvoiceId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  partId          String
  quantity        Int
  unitCost        Float
  totalCost       Float
  fcRate          Float         @default(0)
  fcAmount        Float         @default(0)
  weight          Float         @default(0)
  totalWeight     Float         @default(0)
  receivedQty     Int           @default(0)
  additionalQty   Int           @default(0)
  backQty         Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  Part            Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Rack {
  id                                         String                    @id @default(uuid())
  codeNo                                     String                    @unique
  storeId                                    String?
  description                                String?
  status                                     String                    @default("Active")
  createdAt                                  DateTime                  @default(now())
  updatedAt                                  DateTime                  @updatedAt
  AdjustmentItem                             AdjustmentItem[]
  DirectPurchaseOrderItem                    DirectPurchaseOrderItem[]
  InvoiceRackShelf                           InvoiceRackShelf[]
  PartRackShelf                              PartRackShelf[]
  Store                                      Store?                    @relation(fields: [storeId], references: [id])
  Shelf                                      Shelf[]
  StockMovement                              StockMovement[]
  StockReservation                           StockReservation[]
  StockVerificationItem                      StockVerificationItem[]
  TransferItem_TransferItem_fromRackIdToRack TransferItem[]            @relation("TransferItem_fromRackIdToRack")
  TransferItem_TransferItem_toRackIdToRack   TransferItem[]            @relation("TransferItem_toRackIdToRack")
}

model Receivable {
  id           String       @id @default(uuid())
  invoiceId    String       @unique
  customerId   String?
  amount       Float
  paidAmount   Float        @default(0)
  dueAmount    Float
  dueDate      DateTime?
  status       String       @default("pending")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  Customer     Customer?    @relation(fields: [customerId], references: [id])
  SalesInvoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   @default("Custom")
  description String?
  permissions String
  usersCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalesInquiry {
  id               String             @id @default(uuid())
  inquiryNo        String             @unique
  inquiryDate      DateTime
  customerName     String
  customerEmail    String?
  customerPhone    String?
  subject          String
  description      String?
  status           String             @default("New")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  SalesInquiryItem SalesInquiryItem[]
}

model SalesInquiryItem {
  id            String       @id @default(uuid())
  inquiryId     String
  partId        String
  quantity      Int
  purchasePrice Float?
  priceA        Float?
  priceB        Float?
  priceM        Float?
  location      String?
  stock         Int          @default(0)
  reservedQty   Int          @default(0)
  createdAt     DateTime     @default(now())
  SalesInquiry  SalesInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  Part          Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model LocalInquiry {
  id               String             @id @default(uuid())
  inquiryNo        String             @unique
  inquiryDate      DateTime
  supplierId       String?
  remarks          String?
  status           String             @default("Open")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  LocalInquiryItem LocalInquiryItem[]
}

model LocalInquiryItem {
  id           String       @id @default(uuid())
  inquiryId    String
  partId       String
  quantity     Int          @default(1)
  price        Float        @default(0)
  remarks      String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  LocalInquiry LocalInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  Part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model SalesInvoice {
  id               String             @id @default(uuid())
  invoiceNo        String             @unique
  invoiceDate      DateTime
  term             String?
  customerId       String?
  customerName     String
  customerType     String
  salesPerson      String?
  subtotal         Float              @default(0)
  overallDiscount  Float              @default(0)
  freightCharges   Float              @default(0)
  tax              Float              @default(0)
  taxPercentage    Float?
  grandTotal       Float              @default(0)
  paidAmount       Float              @default(0)
  status           String             @default("pending")
  paymentStatus    String             @default("unpaid")
  accountId        String?
  bankAccountId    String?
  cashAccountId    String?
  bankAmount       Float              @default(0)
  cashAmount       Float              @default(0)
  deliveredTo      String?
  remarks          String?
  quotationId      String?
  holdReason       String?
  holdSince        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  DeliveryLog      DeliveryLog[]
  Receivable       Receivable?
  Account          Account?           @relation(fields: [accountId], references: [id])
  BankAccount      Account?           @relation("SalesInvoiceBankAccount", fields: [bankAccountId], references: [id])
  CashAccount      Account?           @relation("SalesInvoiceCashAccount", fields: [cashAccountId], references: [id])
  Customer         Customer?          @relation(fields: [customerId], references: [id])
  SalesInvoiceItem SalesInvoiceItem[]
  SalesQuotation   SalesQuotation?
  SalesReturn      SalesReturn[]
  StockReservation StockReservation[]
  Voucher          Voucher[]
  VoucherEntry     VoucherEntry[]
}

model SalesInvoiceItem {
  id                String             @id @default(uuid())
  invoiceId         String
  partId            String
  partNo            String
  description       String?
  orderedQty        Int
  deliveredQty      Int                @default(0)
  pendingQty        Int
  unitPrice         Float
  discount          Float              @default(0)
  lineTotal         Float
  grade             String?
  brand             String?
  createdAt         DateTime           @default(now())
  avgCost           Float              @default(0)
  useUnlocatedStock Boolean            @default(false)
  DeliveryLogItem   DeliveryLogItem[]
  InvoiceRackShelf  InvoiceRackShelf[]
  SalesInvoice      SalesInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Part              Part               @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model InvoiceRackShelf {
  id                 String           @id @default(uuid())
  salesInvoiceItemId String
  storeId            String?
  rackId             String?
  shelfId            String?
  quantity           Int              @default(0)
  createdAt          DateTime         @default(now())
  Rack               Rack?            @relation(fields: [rackId], references: [id], onDelete: Cascade)
  SalesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)
  Shelf              Shelf?           @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  Store              Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model SalesQuotation {
  id                 String               @id @default(uuid())
  quotationNo        String               @unique
  quotationDate      DateTime
  validUntil         DateTime
  customerType       String               @default("registered")
  customerId         String?
  customerName       String
  customerEmail      String?
  customerPhone      String?
  customerAddress    String?
  status             String               @default("draft")
  subtotal           Float                @default(0)
  overallDiscount    Float                @default(0)
  freightCharges     Float                @default(0)
  tax                Float                @default(0)
  taxPercentage      Float?
  totalAmount        Float                @default(0)
  notes              String?
  invoiceId          String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Customer           Customer?            @relation(fields: [customerId], references: [id])
  SalesInvoice       SalesInvoice?        @relation(fields: [invoiceId], references: [id])
  SalesQuotationItem SalesQuotationItem[]
}

model SalesQuotationItem {
  id             String         @id @default(uuid())
  quotationId    String
  partId         String
  partNo         String
  description    String?
  quantity       Int
  unitPrice      Float
  total          Float
  createdAt      DateTime       @default(now())
  Part           Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  SalesQuotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesReturn {
  id                 String            @id @default(uuid())
  returnNumber       String            @unique
  salesInvoiceId     String?
  isDirectReturn     Boolean           @default(false)
  legacyInvoiceNo    String?
  legacyCustomerName String?
  customerType       String?
  returnDate         DateTime
  reason             String?
  status             String            @default("pending")
  subtotal           Float             @default(0)
  tax                Float             @default(0)
  taxPercentage      Float             @default(0)
  deduction          Float             @default(0)
  totalAmount        Float             @default(0)
  paymentAccountId   String?
  paidAmount         Float             @default(0)
  createdBy          String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  customerId         String?
  Customer           Customer?         @relation(fields: [customerId], references: [id])
  PaymentAccount     Account?          @relation("SalesReturnPaymentAccount", fields: [paymentAccountId], references: [id])
  SalesInvoice       SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  SalesReturnItem    SalesReturnItem[]
  Voucher            Voucher[]

  @@index([returnDate])
  @@index([salesInvoiceId])
  @@index([status])
  @@index([isDirectReturn])
}

model SalesReturnItem {
  id                String      @id @default(uuid())
  salesReturnId     String
  partId            String
  returnQuantity    Int
  originalSalePrice Float
  amount            Float
  createdAt         DateTime    @default(now())
  avgCost           Float       @default(0)
  Part              Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  SalesReturn       SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([salesReturnId])
}

model Shelf {
  id                                           String                    @id @default(uuid())
  shelfNo                                      String
  rackId                                       String
  description                                  String?
  status                                       String                    @default("Active")
  createdAt                                    DateTime                  @default(now())
  updatedAt                                    DateTime                  @updatedAt
  AdjustmentItem                               AdjustmentItem[]
  DirectPurchaseOrderItem                      DirectPurchaseOrderItem[]
  InvoiceRackShelf                             InvoiceRackShelf[]
  PartRackShelf                                PartRackShelf[]
  Rack                                         Rack                      @relation(fields: [rackId], references: [id], onDelete: Cascade)
  StockMovement                                StockMovement[]
  StockReservation                             StockReservation[]
  StockVerificationItem                        StockVerificationItem[]
  TransferItem_TransferItem_fromShelfIdToShelf TransferItem[]            @relation("TransferItem_fromShelfIdToShelf")
  TransferItem_TransferItem_toShelfIdToShelf   TransferItem[]            @relation("TransferItem_toShelfIdToShelf")

  @@unique([rackId, shelfNo])
}

model StockMovement {
  id            String    @id @default(uuid())
  partId        String
  type          String
  quantity      Int
  storeId       String?
  rackId        String?
  shelfId       String?
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime  @default(now())
  supplierId    String?
  Part          Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack          Rack?     @relation(fields: [rackId], references: [id])
  Shelf         Shelf?    @relation(fields: [shelfId], references: [id])
  Store         Store?    @relation(fields: [storeId], references: [id])
  Supplier      Supplier? @relation(fields: [supplierId], references: [id])
}

model StockReservation {
  id                String        @id @default(uuid())
  invoiceId         String?
  partId            String
  quantity          Int
  reservedAt        DateTime      @default(now())
  releasedAt        DateTime?
  status            String        @default("reserved")
  notes             String?
  rackId            String?
  shelfId           String?
  storeId           String?
  useUnlocatedStock Boolean       @default(false)
  SalesInvoice      SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Part              Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack              Rack?         @relation(fields: [rackId], references: [id])
  Shelf             Shelf?        @relation(fields: [shelfId], references: [id])
  Store             Store?        @relation(fields: [storeId], references: [id])
}

model StockVerification {
  id                    String                  @id @default(uuid())
  name                  String
  notes                 String?
  status                String                  @default("Active")
  startDate             DateTime                @default(now())
  completedDate         DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  StockVerificationItem StockVerificationItem[]
}

model StockVerificationItem {
  id                String            @id @default(uuid())
  verificationId    String
  partId            String
  storeId           String?
  rackId            String?
  shelfId           String?
  systemQty         Int
  physicalQty       Int?
  variance          Int?
  status            String            @default("Pending")
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  Part              Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack              Rack?             @relation(fields: [rackId], references: [id])
  Shelf             Shelf?            @relation(fields: [shelfId], references: [id])
  Store             Store?            @relation(fields: [storeId], references: [id])
  StockVerification StockVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

model Store {
  id                                           String                  @id @default(uuid())
  code                                         String                  @unique
  name                                         String
  address                                      String?
  phone                                        String?
  manager                                      String?
  status                                       String                  @default("active")
  createdAt                                    DateTime                @default(now())
  updatedAt                                    DateTime                @updatedAt
  Adjustment                                   Adjustment[]
  DirectPurchaseOrder                          DirectPurchaseOrder[]
  InvoiceRackShelf                             InvoiceRackShelf[]
  PartRackShelf                                PartRackShelf[]
  Rack                                         Rack[]
  StockMovement                                StockMovement[]
  StockReservation                             StockReservation[]
  StockVerificationItem                        StockVerificationItem[]
  Transfer_Transfer_fromStoreIdToStore         Transfer[]              @relation("Transfer_fromStoreIdToStore")
  Transfer_Transfer_toStoreIdToStore           Transfer[]              @relation("Transfer_toStoreIdToStore")
  TransferItem_TransferItem_fromStoreIdToStore TransferItem[]          @relation("TransferItem_fromStoreIdToStore")
  TransferItem_TransferItem_toStoreIdToStore   TransferItem[]          @relation("TransferItem_toStoreIdToStore")
  Voucher                                      Voucher[]
}

model Subcategory {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Application Application[]
  Part        Part[]
  Category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

model Subgroup {
  id          String    @id @default(uuid())
  mainGroupId String
  code        String    @unique
  name        String
  isActive    Boolean   @default(true)
  canDelete   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Account     Account[]
  MainGroup   MainGroup @relation(fields: [mainGroupId], references: [id], onDelete: Cascade)
}

model Supplier {
  id                        String                      @id @default(uuid())
  code                      String                      @unique
  type                      String                      @default("local")
  currencyName              String?
  name                      String?
  companyName               String?
  address                   String?
  city                      String?
  state                     String?
  country                   String?
  zipCode                   String?
  email                     String?
  phone                     String?
  cnic                      String?
  contactPerson             String?
  taxId                     String?
  paymentTerms              String?
  openingBalance            Float                       @default(0)
  date                      DateTime?
  status                    String                      @default("active")
  notes                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  accountHead               String?
  area                      String?
  cellNumber                String?
  contactPersons            Json?                       @default("[]")
  gstNumber                 String?
  ntn                       String?
  referenceName             String?
  remarks                   String?
  shortTitle                String?
  Account                   Account[]
  DirectPurchaseOrder       DirectPurchaseOrder[]
  DirectPurchaseOrderReturn DirectPurchaseOrderReturn[]
  PurchaseOrder             PurchaseOrder[]
  PurchaseImportRequest     PurchaseImportRequest[]
  PurchaseQuotation         PurchaseQuotation[]
  StockMovement             StockMovement[]
  VoucherEntry              VoucherEntry[]
  LocalInquiry              LocalInquiry[]
}

model Transfer {
  id                                String         @id @default(uuid())
  transferNumber                    String         @unique
  date                              DateTime
  status                            String         @default("Draft")
  notes                             String?
  totalQty                          Int            @default(0)
  fromStoreId                       String?
  toStoreId                         String?
  createdAt                         DateTime       @default(now())
  updatedAt                         DateTime       @updatedAt
  Store_Transfer_fromStoreIdToStore Store?         @relation("Transfer_fromStoreIdToStore", fields: [fromStoreId], references: [id])
  Store_Transfer_toStoreIdToStore   Store?         @relation("Transfer_toStoreIdToStore", fields: [toStoreId], references: [id])
  TransferItem                      TransferItem[]
}

model TransferItem {
  id                                    String   @id @default(uuid())
  transferId                            String
  partId                                String
  fromStoreId                           String?
  fromRackId                            String?
  fromShelfId                           String?
  toStoreId                             String?
  toRackId                              String?
  toShelfId                             String?
  quantity                              Int
  createdAt                             DateTime @default(now())
  Rack_TransferItem_fromRackIdToRack    Rack?    @relation("TransferItem_fromRackIdToRack", fields: [fromRackId], references: [id])
  Shelf_TransferItem_fromShelfIdToShelf Shelf?   @relation("TransferItem_fromShelfIdToShelf", fields: [fromShelfId], references: [id])
  Store_TransferItem_fromStoreIdToStore Store?   @relation("TransferItem_fromStoreIdToStore", fields: [fromStoreId], references: [id])
  Part                                  Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack_TransferItem_toRackIdToRack      Rack?    @relation("TransferItem_toRackIdToRack", fields: [toRackId], references: [id])
  Shelf_TransferItem_toShelfIdToShelf   Shelf?   @relation("TransferItem_toShelfIdToShelf", fields: [toShelfId], references: [id])
  Store_TransferItem_toStoreIdToStore   Store?   @relation("TransferItem_toStoreIdToStore", fields: [toStoreId], references: [id])
  Transfer                              Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  roleId    String   @default("Staff")
  status    String   @default("active")
  lastLogin String?  @default("-")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id                                          String         @id @default(uuid())
  voucherNumber                               String         @unique
  type                                        String
  date                                        DateTime
  narration                                   String?
  cashBankAccount                             String?
  chequeNumber                                String?
  chequeDate                                  DateTime?
  checkClearDate                              DateTime?
  isCleared                                   Int?
  totalDebit                                  Float          @default(0)
  totalCredit                                 Float          @default(0)
  status                                      String         @default("draft")
  createdBy                                   String?
  approvedBy                                  String?
  approvedAt                                  DateTime?
  isSystemGenerated                           Boolean        @default(false)
  conversionRate                              Float?
  createdAt                                   DateTime       @default(now())
  updatedAt                                   DateTime       @updatedAt
  deletedAt                                   DateTime?
  storeId                                     String?
  adjustmentId                                String?
  salesInvoiceId                              String?
  salesReturnId                               String?
  Adjustment_Adjustment_voucherIdToVoucher    Adjustment[]   @relation("Adjustment_voucherIdToVoucher")
  Adjustment_Voucher_adjustmentIdToAdjustment Adjustment?    @relation("Voucher_adjustmentIdToAdjustment", fields: [adjustmentId], references: [id])
  SalesInvoice                                SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id])
  SalesReturn                                 SalesReturn?     @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)
  Store                                       Store?         @relation(fields: [storeId], references: [id])
  VoucherEntry                                VoucherEntry[]
  EmployeeTransaction                         EmployeeTransaction[]

  @@index([salesReturnId])
}

model VoucherEntry {
  id             String        @id @default(uuid())
  voucherId      String
  accountId      String?
  accountName    String
  description    String?
  debit          Float         @default(0)
  credit         Float         @default(0)
  sortOrder      Int           @default(0)
  supplierId     String?
  customerId     String?
  employeeId     String?
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  adjustmentId   String?
  salesInvoiceId String?
  Account        Account?      @relation(fields: [accountId], references: [id])
  Adjustment     Adjustment?   @relation(fields: [adjustmentId], references: [id])
  Customer       Customer?     @relation(fields: [customerId], references: [id])
  Employee       Employee?     @relation(fields: [employeeId], references: [id])
  SalesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  Supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  Voucher        Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model WhatsAppSettings {
  id                       String   @id @default(uuid())
  appKey                   String?
  authKey                  String?
  administratorPhoneNumber String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PartRackShelf {
  id        String   @id @default(uuid())
  partId    String
  storeId   String?
  rackId    String?
  shelfId   String?
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  Rack      Rack?    @relation(fields: [rackId], references: [id])
  Shelf     Shelf?   @relation(fields: [shelfId], references: [id])
  Store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([partId, storeId, rackId, shelfId])
}
