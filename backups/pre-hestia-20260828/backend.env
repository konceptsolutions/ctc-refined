# Database Configuration
# This tells the application and Prisma where to find the PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://koncepts_user:password123@localhost:5432/koncepts_dev?schema=public"

# PgAdmin / Database Credentials (Reference)
# Use these credentials to connect via PgAdmin or other clients
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=koncepts_dev

# Server
PORT=5001

# SMTP (Hostinger) — used to send inquiry emails from sales@crystaltrading.pk
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@crystaltrading.pk
SMTP_PASS=your-email-password
SMTP_FROM="Crystal Trading <sales@crystaltrading.pk>"
